{
  "name": "dsh-fingerprint",
  "version": "0.1.0",
  "description": "dsh-fingerprint: 在 DSH 左侧栏对已配置模型跑 LM Fingerpoint Detection 指纹检测",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "license": "MIT",
  "author": "Practice019",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Practice019/dsh-fingerprint.git"
  },
  "homepage": "https://github.com/Practice019/dsh-fingerprint#readme",
  "bugs": {
    "url": "https://github.com/Practice019/dsh-fingerprint/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fingerprint",
    "llm",
    "model-detection",
    "lmfpd"
  ],
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {
    "lmfpd-sdk": "^0.2.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "git",
      "git": "https://github.com/Practice019/dsh-fingerprint.git"
    }
  }
}
